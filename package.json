{
  "name": "youtube-drama-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests scripts",
    "format": "prettier --write src tests scripts *.json *.mjs *.html",
    "format:check": "prettier --check src tests scripts *.json *.mjs *.html",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "papaparse": "5.5.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@mixmark-io/domino": "2.2.0",
    "@types/chrome": "0.0.287",
    "@types/node": "24.13.3",
    "@types/papaparse": "5.3.16",
    "eslint": "9.39.5",
    "fake-indexeddb": "6.0.0",
    "prettier": "3.4.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
